# Server Configuration
PORT=8787
NODE_ENV=development

# Azure SQL Database
# Format: mssql://user:password@server.database.windows.net:1433/database?encrypt=true
DATABASE_URL=mssql://user:password@server.database.windows.net:1433/arttherapy-plus?encrypt=true

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=images
AZURE_STORAGE_PUBLIC_URL=https://youraccount.blob.core.windows.net/images

# JWT Secret (must match the Cloudflare Worker for token compatibility)
JWT_SECRET=your-jwt-secret-here

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Microsoft OAuth (for user info fetching - client secret not needed for PKCE)
MICROSOFT_CLIENT_ID=1068db0a-2e86-4094-aa91-b55bca8ac09a
